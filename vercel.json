{
  "rewrites": [
    {
      "source": "/v1/health",
      "has": [
        { "type": "host", "value": "api.rolecolorfinder.com" }
      ],
      "destination": "https://qbuxoetprodjxpagfkoi.supabase.co/functions/v1/api-gateway"
    },
    {
      "source": "/v1/users/:path*",
      "has": [
        { "type": "host", "value": "api.rolecolorfinder.com" }
      ],
      "destination": "https://qbuxoetprodjxpagfkoi.supabase.co/functions/v1/api-users"
    },
    {
      "source": "/v1/assessments/:path*",
      "has": [
        { "type": "host", "value": "api.rolecolorfinder.com" }
      ],
      "destination": "https://qbuxoetprodjxpagfkoi.supabase.co/functions/v1/api-assessments"
    },
    {
      "source": "/v1/:path*",
      "has": [
        { "type": "host", "value": "api.rolecolorfinder.com" }
      ],
      "destination": "https://qbuxoetprodjxpagfkoi.supabase.co/functions/v1/api-gateway"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?:text/html|\\*/\\*)"
        }
      ]
    }
  ]
}
